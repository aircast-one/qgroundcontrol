<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Pages.Setup.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource BgBaseBrush}">
        <Grid x:Name="TwoPane" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="360" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ListPane"
                    Background="{ThemeResource BgSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Padding="16,20,16,8" Spacing="2">
                        <TextBlock Text="Aircraft setup"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="{ThemeResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SubtitleText"
                                   TextWrapping="Wrap"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="{ThemeResource FontSizeBody}"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:Name="VehicleText"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="{ThemeResource FontSizeCaption}"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:Name="ReadinessText"
                                   TextWrapping="Wrap"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="{ThemeResource FontSizeCaption}"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>

                    <TextBox x:Name="SearchBox"
                             Grid.Row="1"
                             Margin="16,4,16,8"
                             PlaceholderText="Search"
                             FontFamily="{ThemeResource AppFontFamily}" />

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ComponentList" Padding="8,0,8,16" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid x:Name="DetailPane" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="760" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="DetailHeader" ColumnSpacing="8" Margin="24,20,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton"
                            Width="36" Height="36" Padding="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                            Content="&#xE72B;"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Back to Aircraft setup"
                            ToolTipService.ToolTip="Back to Aircraft setup" />
                    <TextBlock x:Name="DetailTitle"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="{ThemeResource AppFontFamily}"
                               FontSize="{ThemeResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                </Grid>

                <TextBlock x:Name="BlockedText"
                           Grid.Row="1"
                           Margin="24,0,24,8"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           FontFamily="{ThemeResource AppFontFamily}"
                           FontSize="{ThemeResource FontSizeBody}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource CautionBrush}" />

                <ContentControl x:Name="DetailHost"
                                Grid.Row="2"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsTabStop="False" />
            </Grid>
        </Grid>

        <ScrollViewer x:Name="StateScroller" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="StateHost"
                            HorizontalAlignment="Center"
                            MaxWidth="560"
                            HorizontalContentAlignment="Stretch"
                            IsTabStop="False" />
        </ScrollViewer>

        <InfoBar x:Name="NavigationNotice"
                 Severity="Warning"
                 IsClosable="True"
                 IsOpen="False"
                 MaxWidth="480"
                 Margin="16"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top" />
    </Grid>
</UserControl>
