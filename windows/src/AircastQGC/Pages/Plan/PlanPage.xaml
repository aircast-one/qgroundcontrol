<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Pages.Plan.PlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AircastQGC.Controls"
    FontFamily="{ThemeResource AppFontFamily}"
    FontSize="{ThemeResource FontSizeBody}">

    <UserControl.Resources>
        <Style x:Key="PlanDialog" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
            <Setter Property="Background" Value="{ThemeResource LayerBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        </Style>

        <Style x:Key="PlanMenuPresenter" TargetType="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{ThemeResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusOverlay}" />
        </Style>

        <Style x:Key="FloatingCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusOverlay}" />
        </Style>

        <Style x:Key="Rail" TargetType="Border" BasedOn="{StaticResource FloatingCard}">
            <Setter Property="Padding" Value="4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="RailIcon" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeSubtitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PanelDetail" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource BgBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{ThemeResource LayerBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel Padding="16" Spacing="{StaticResource SpaceMd}">
                    <Grid x:Name="StripRow" ColumnSpacing="{StaticResource SpaceSm}" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <StackPanel x:Name="Strip" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" Padding="0,0,0,8" />
                        </ScrollViewer>
                        <ToggleButton x:Name="ProfileButton" Grid.Column="1"
                                      Width="36" Height="36" Padding="0" VerticalAlignment="Top"
                                      FontFamily="{StaticResource IconFontFamily}" Content="&#xE9D2;"
                                      Click="OnProfileToggled"
                                      ToolTipService.ToolTip="Terrain profile"
                                      AutomationProperties.Name="Terrain profile" />
                    </Grid>

                    <Grid x:Name="SelectionHeader" ColumnSpacing="{StaticResource SpaceSm}" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectionTitle" Style="{StaticResource PanelTitle}" />
                            <TextBlock x:Name="SelectionDetail" Style="{StaticResource PanelDetail}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Done" Style="{StaticResource AccentButtonStyle}"
                                Click="OnDone" AutomationProperties.Name="Done" />
                    </Grid>

                    <StackPanel x:Name="EmptyState" Spacing="{StaticResource SpaceXs}" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="Tap the map to add a waypoint" TextWrapping="Wrap" />
                        <TextBlock x:Name="HomeHint" Style="{StaticResource PanelDetail}" Text="The first tap also sets home." />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                            <Button x:Name="TemplatesButton" Content="Templates" Click="OnTemplates" />
                            <Button x:Name="EmptyDownloadButton" Content="Download from vehicle" Click="OnEmptyDownload" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="LayerTitle" Style="{StaticResource PanelTitle}" Visibility="Collapsed" />

                    <ContentControl x:Name="ProfileHost" HorizontalContentAlignment="Stretch" />

                    <ContentControl x:Name="EditorHost" HorizontalContentAlignment="Stretch" />

                    <StackPanel x:Name="ListHost" Spacing="{StaticResource SpaceXs}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="MapArea" Grid.Column="1">
            <controls:MapView x:Name="Map" />

            <Canvas x:Name="Overlay" />

            <Grid VerticalAlignment="Top" Margin="8" ColumnSpacing="{StaticResource SpaceSm}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource FloatingCard}" Padding="16,6" MinHeight="40">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PlanTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock x:Name="PlanLine" FontSize="{ThemeResource FontSizeCaption}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Button x:Name="PillButton" Grid.Column="1"
                        Height="40" CornerRadius="20" Padding="0"
                        Click="OnPill" AutomationProperties.Name="Upload">
                    <Grid Height="40">
                        <Rectangle x:Name="PillProgress" HorizontalAlignment="Left" Width="0"
                                   Fill="{ThemeResource TextPrimaryBrush}" Opacity="0.2" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" Padding="20,0,24,0" VerticalAlignment="Center">
                            <FontIcon x:Name="PillIcon" FontSize="16" Glyph="&#xE898;" />
                            <TextBlock x:Name="PillText" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="MenuButton" Grid.Column="2"
                        Width="40" Height="40" CornerRadius="20" Padding="0"
                        FontFamily="{StaticResource IconFontFamily}" Content="&#xE712;"
                        Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        ToolTipService.ToolTip="Plan menu" AutomationProperties.Name="Plan menu">
                    <Button.Flyout>
                        <MenuFlyout x:Name="PlanMenu" Placement="BottomEdgeAlignedRight" Opening="OnMenuOpening"
                                    MenuFlyoutPresenterStyle="{StaticResource PlanMenuPresenter}">
                            <MenuFlyoutItem x:Name="RedoItem" Text="Redo" Click="OnRedo">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="OpenItem" Text="Open plan…" Click="OnOpen">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SaveItem" Text="Save" Click="OnSave">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SaveAsItem" Text="Save as…" Click="OnSaveAs">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ExportItem" Text="Export KML…" Click="OnExportKml">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE724;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ImportItem" Text="Import boundary…" Click="OnImportBoundary">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE707;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Defaults…" Click="OnDefaults">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9E9;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="TransformItem" Text="Transform…" Click="OnTransform">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7AD;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="NewItem" Text="New plan…" Click="OnNewPlan">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="DownloadItem" Text="Load from vehicle" Click="OnDownload">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ClearItem" Text="Clear mission" Click="OnClearMission"
                                            Foreground="{ThemeResource CriticalBrush}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource CriticalBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <Border Style="{StaticResource Rail}" HorizontalAlignment="Left" Margin="8,64,0,8">
                <StackPanel x:Name="RailItems" Spacing="2" />
            </Border>

            <Border Style="{StaticResource Rail}" HorizontalAlignment="Right" Margin="0,64,8,8">
                <StackPanel Spacing="2">
                    <Button x:Name="UndoButton" Style="{StaticResource RailIcon}" Content="&#xE7A7;" Click="OnUndo"
                            ToolTipService.ToolTip="Undo" AutomationProperties.Name="Undo" />
                    <Button x:Name="CentreButton" Style="{StaticResource RailIcon}" Content="&#xE81D;"
                            ToolTipService.ToolTip="Centre" AutomationProperties.Name="Centre">
                        <Button.Flyout>
                            <MenuFlyout x:Name="CentreMenu" Placement="LeftEdgeAlignedTop" Opening="OnCentreOpening"
                                        MenuFlyoutPresenterStyle="{StaticResource PlanMenuPresenter}" />
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource RailIcon}" Content="&#xE710;" Click="OnZoomIn"
                            ToolTipService.ToolTip="Zoom in" AutomationProperties.Name="Zoom in" />
                    <Button Style="{StaticResource RailIcon}" Content="&#xE738;" Click="OnZoomOut"
                            ToolTipService.ToolTip="Zoom out" AutomationProperties.Name="Zoom out" />
                    <Button Style="{StaticResource RailIcon}" Content="&#xE81E;"
                            ToolTipService.ToolTip="Map type" AutomationProperties.Name="Map type">
                        <Button.Flyout>
                            <MenuFlyout x:Name="MapTypeMenu" Placement="LeftEdgeAlignedTop" Opening="OnMapTypeOpening"
                                        MenuFlyoutPresenterStyle="{StaticResource PlanMenuPresenter}" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="72,64,72,8"
                        MaxWidth="520" Spacing="{StaticResource SpaceSm}">
                <Border x:Name="BusyCard" Style="{StaticResource FloatingCard}" Padding="16,10" Visibility="Collapsed">
                    <TextBlock x:Name="BusyText" TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}" />
                </Border>
                <Border x:Name="UndrawnCard" Padding="16,8" Visibility="Collapsed"
                        Background="{ThemeResource CriticalBgBrush}" CornerRadius="{StaticResource RadiusOverlay}">
                    <TextBlock x:Name="UndrawnText" TextWrapping="Wrap" FontSize="{ThemeResource FontSizeCaption}"
                               Foreground="{ThemeResource CriticalBrush}" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
