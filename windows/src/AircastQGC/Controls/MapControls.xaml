<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.MapControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{ThemeResource AppFontFamily}">

    <StackPanel Spacing="{StaticResource SpaceSm}">
        <Button x:Name="ZoomInButton"
                Style="{StaticResource FlyRoundButton}"
                HorizontalAlignment="Center"
                Content="&#xE710;"
                Click="OnZoomIn"
                ToolTipService.ToolTip="Zoom in"
                AutomationProperties.Name="Zoom in" />
        <Button x:Name="ZoomOutButton"
                Style="{StaticResource FlyRoundButton}"
                HorizontalAlignment="Center"
                Content="&#xE738;"
                Click="OnZoomOut"
                ToolTipService.ToolTip="Zoom out"
                AutomationProperties.Name="Zoom out" />
        <Button x:Name="CenterButton"
                Style="{StaticResource FlyRoundButton}"
                HorizontalAlignment="Center"
                Content="&#xE81D;"
                Click="OnCenter"
                IsEnabled="False"
                ToolTipService.ToolTip="Center on vehicle"
                AutomationProperties.Name="Center on vehicle" />
        <Button x:Name="LayersButton"
                Style="{StaticResource FlyRailButton}"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                Content="&#xE81E;"
                ToolTipService.ToolTip="Map layers"
                AutomationProperties.Name="Map layers">
            <Button.Flyout>
                <MenuFlyout x:Name="LayersMenu"
                            Placement="LeftEdgeAlignedBottom"
                            Opening="OnLayersOpening" />
            </Button.Flyout>
        </Button>
        <Button x:Name="ThreeDButton"
                Style="{StaticResource FlyRailButton}"
                HorizontalAlignment="Center"
                Content="&#xF158;"
                Click="OnThreeD"
                Visibility="Collapsed"
                ToolTipService.ToolTip="Show the 3D view"
                AutomationProperties.Name="Show the 3D view" />
    </StackPanel>
</UserControl>
