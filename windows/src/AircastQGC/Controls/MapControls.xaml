<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.MapControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{ThemeResource AppFontFamily}">

    <UserControl.Resources>
        <Style x:Key="MapTypeMenuPresenter" TargetType="MenuFlyoutPresenter">
            <Setter Property="RequestedTheme" Value="Dark" />
            <Setter Property="Background" Value="{ThemeResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusOverlay}" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="{StaticResource SpaceXs}" RequestedTheme="Dark">
        <Button x:Name="ZoomInButton"
                Style="{StaticResource MapControl}"
                Content="&#xE710;"
                Click="OnZoomIn"
                ToolTipService.ToolTip="Zoom in"
                AutomationProperties.Name="Zoom in" />
        <Button x:Name="ZoomOutButton"
                Style="{StaticResource MapControl}"
                Content="&#xE738;"
                Click="OnZoomOut"
                ToolTipService.ToolTip="Zoom out"
                AutomationProperties.Name="Zoom out" />
        <Button x:Name="CenterButton"
                Style="{StaticResource MapControl}"
                Content="&#xE81D;"
                Click="OnCenter"
                IsEnabled="False"
                ToolTipService.ToolTip="Center on vehicle"
                AutomationProperties.Name="Center on vehicle" />
        <Button x:Name="LayersButton"
                Style="{StaticResource MapControl}"
                Content="&#xE81E;"
                ToolTipService.ToolTip="Map type"
                AutomationProperties.Name="Map type">
            <Button.Flyout>
                <MenuFlyout x:Name="LayersMenu"
                            Placement="LeftEdgeAlignedTop"
                            Opening="OnLayersOpening"
                            MenuFlyoutPresenterStyle="{StaticResource MapTypeMenuPresenter}" />
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
