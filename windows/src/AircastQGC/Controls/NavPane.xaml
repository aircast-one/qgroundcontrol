<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.NavPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="PaneButton" TargetType="Button">
            <Setter Property="Height" Value="{StaticResource SizeNavItem}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleSelectedBrush}" />
                                            <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneIconButton" TargetType="Button" BasedOn="{StaticResource PaneButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="NavIndicator" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style x:Key="NavIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent" Padding="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <Button x:Name="BackButton" Style="{StaticResource PaneIconButton}" IsEnabled="False" Click="OnBack"
                    AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <Button x:Name="ToggleButton" Style="{StaticResource PaneIconButton}" Click="OnToggle"
                    AutomationProperties.Name="Navigation" ToolTipService.ToolTip="Navigation">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
            </Button>

            <Button x:Name="FlyItem" Tag="Fly" Style="{StaticResource PaneButton}" Click="OnNavigate"
                    AutomationProperties.Name="Fly" ToolTipService.ToolTip="Fly">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource NavIndicator}" />
                    <FontIcon Grid.Column="1" Glyph="&#xE709;" Style="{StaticResource NavIcon}" />
                    <TextBlock Grid.Column="2" Text="Fly" Style="{StaticResource NavLabel}" />
                </Grid>
            </Button>

            <Button x:Name="PlanItem" Tag="Plan" Style="{StaticResource PaneButton}" Click="OnNavigate"
                    AutomationProperties.Name="Plan" ToolTipService.ToolTip="Plan">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource NavIndicator}" />
                    <FontIcon Grid.Column="1" Glyph="&#xE707;" Style="{StaticResource NavIcon}" />
                    <TextBlock Grid.Column="2" Text="Plan" Style="{StaticResource NavLabel}" />
                </Grid>
            </Button>

            <Button x:Name="AnalyzeItem" Tag="Analyze" Style="{StaticResource PaneButton}" Click="OnNavigate"
                    AutomationProperties.Name="Analyze" ToolTipService.ToolTip="Analyze">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource NavIndicator}" />
                    <FontIcon Grid.Column="1" Glyph="&#xE9D9;" Style="{StaticResource NavIcon}" />
                    <TextBlock Grid.Column="2" Text="Analyze" Style="{StaticResource NavLabel}" />
                </Grid>
            </Button>

            <Button x:Name="SetupItem" Tag="Vehicle Setup" Style="{StaticResource PaneButton}" Click="OnNavigate"
                    AutomationProperties.Name="Vehicle Setup" ToolTipService.ToolTip="Vehicle Setup">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource NavIndicator}" />
                    <FontIcon Grid.Column="1" Glyph="&#xE90F;" Style="{StaticResource NavIcon}" />
                    <TextBlock Grid.Column="2" Text="Vehicle Setup" Style="{StaticResource NavLabel}" />
                </Grid>
            </Button>
        </StackPanel>

        <Button x:Name="SettingsItem" Grid.Row="2" Tag="Settings" Style="{StaticResource PaneButton}" Click="OnNavigate"
                AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource NavIndicator}" />
                <FontIcon Grid.Column="1" Glyph="&#xE713;" Style="{StaticResource NavIcon}" />
                <TextBlock Grid.Column="2" Text="Settings" Style="{StaticResource NavLabel}" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
