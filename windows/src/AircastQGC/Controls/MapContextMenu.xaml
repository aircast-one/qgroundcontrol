<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.MapContextMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AircastQGC.Controls"
    FontFamily="{ThemeResource AppFontFamily}"
    Visibility="Collapsed">

    <UserControl.Resources>
        <StaticResource x:Key="AccentButtonBackground" ResourceKey="AccentBrush" />
        <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentHoverBrush" />
        <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AccentHoverBrush" />
        <StaticResource x:Key="AccentButtonForeground" ResourceKey="AccentOnBrush" />
        <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="AccentOnBrush" />
        <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="AccentOnBrush" />
    </UserControl.Resources>

    <Grid RequestedTheme="Dark" KeyDown="OnMenuKeyDown">
        <Border Background="Transparent" Tapped="OnScrimTapped" RightTapped="OnScrimRightTapped" />
        <Canvas>
            <Border x:Name="Card"
                    Width="240"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusOverlay}"
                    SizeChanged="OnCardSizeChanged">
                <StackPanel>
                    <StackPanel x:Name="MenuPanel">
                        <TextBlock x:Name="MenuCoordinate"
                                   Margin="12,8"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   IsTextSelectionEnabled="True" />
                        <Border Height="1" Background="{ThemeResource DividerBrush}" />
                        <ListView x:Name="ActionList"
                                  Padding="0,4"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnActionClick"
                                  AutomationProperties.Name="Map actions">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:MapClickAction">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
                                        <FontIcon Width="16"
                                                  Glyph="{x:Bind Glyph}"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Label}"
                                                   FontFamily="{ThemeResource AppFontFamily}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Padding="16" Spacing="{StaticResource SpaceMd}">
                        <TextBlock x:Name="ConfirmTitle"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="{StaticResource FontSizeSubtitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ConfirmMessage"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ConfirmWarning"
                                   Visibility="Collapsed"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource CautionBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="OrbitFields" Visibility="Collapsed" Spacing="{StaticResource SpaceSm}">
                            <NumberBox x:Name="OrbitRadius"
                                       Header="Radius"
                                       Minimum="0"
                                       SpinButtonPlacementMode="Compact"
                                       AutomationProperties.Name="Orbit radius" />
                            <ToggleSwitch x:Name="OrbitClockwise"
                                          Header="Direction"
                                          OnContent="Clockwise"
                                          OffContent="Counter-clockwise"
                                          IsOn="True" />
                            <NumberBox x:Name="OrbitHeight"
                                       Header="Height above launch"
                                       SpinButtonPlacementMode="Compact"
                                       AutomationProperties.Name="Orbit height above launch" />
                        </StackPanel>
                        <TextBlock x:Name="ConfirmCoordinate"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   IsTextSelectionEnabled="True" />
                        <Button x:Name="ReturnHomeButton"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch"
                                Content="Return home instead"
                                CornerRadius="{StaticResource RadiusControl}"
                                Click="OnReturnHome" />
                        <Grid ColumnSpacing="{StaticResource SpaceSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CancelButton"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Content="Cancel"
                                    CornerRadius="{StaticResource RadiusControl}"
                                    Click="OnCancel" />
                            <Button x:Name="ConfirmButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}"
                                    CornerRadius="{StaticResource RadiusControl}"
                                    Click="OnConfirm" />
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="Refusal"
                               Visibility="Collapsed"
                               Margin="16,0,16,12"
                               FontFamily="{ThemeResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{ThemeResource CriticalBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
