<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.MapContextMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AircastQGC.Controls"
    FontFamily="{ThemeResource AppFontFamily}"
    KeyboardAcceleratorPlacementMode="Hidden"
    Visibility="Collapsed">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
    </UserControl.KeyboardAccelerators>

    <Grid RequestedTheme="Dark">
        <Border Background="Transparent" Tapped="OnScrimTapped" RightTapped="OnScrimRightTapped" />
        <Canvas>
            <Border x:Name="Card"
                    Width="240"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusOverlay}"
                    SizeChanged="OnCardSizeChanged">
                <StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="MenuCoordinate"
                                   Margin="12,8"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   IsTextSelectionEnabled="True" />
                        <Border Height="1" Background="{ThemeResource DividerBrush}" />
                        <ListView x:Name="ActionList"
                                  Padding="0,4"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnActionClick"
                                  AutomationProperties.Name="Map actions">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:MapClickAction">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
                                        <FontIcon Width="16"
                                                  Glyph="{x:Bind Glyph}"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Label}"
                                                   FontFamily="{ThemeResource AppFontFamily}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <TextBlock x:Name="Refusal"
                               Visibility="Collapsed"
                               Margin="16,0,16,12"
                               FontFamily="{ThemeResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{ThemeResource CriticalBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
