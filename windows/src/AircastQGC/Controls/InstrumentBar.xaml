<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.InstrumentBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ReadingCell" TargetType="Border">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="ReadingLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}">
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ReadingValue" TargetType="TextBlock" BasedOn="{StaticResource StatValue}" />
        <Style x:Key="ReadingMissing" TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        </Style>
        <Style x:Key="ReadingUnits" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="ReadingAbsent" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource CautionBrush}" />
            <Setter Property="MaxLines" Value="1" />
        </Style>

        <Style x:Key="EditorDialog" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
            <Setter Property="Background" Value="{ThemeResource LayerBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        </Style>
        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusOverlay}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style x:Key="EditorRow" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        </Style>
        <Style x:Key="EditorRowCurrent" TargetType="Button" BasedOn="{StaticResource EditorRow}">
            <Setter Property="Background" Value="{ThemeResource SubtleSelectedBrush}" />
        </Style>
        <Style x:Key="EditorTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="EditorDetail" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="EditorNote" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="{StaticResource SpaceXs}">
        <StackPanel x:Name="NoticeRow" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" Visibility="Collapsed">
            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource CriticalBrush}" />
            <TextBlock x:Name="NoticeText" FontFamily="{ThemeResource AppFontFamily}"
                       FontSize="{ThemeResource FontSizeCaption}" Foreground="{ThemeResource CriticalBrush}" />
        </StackPanel>
        <Border x:Name="Card" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusOverlay}" Padding="8" Visibility="Collapsed">
            <StackPanel x:Name="Readings" Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" />
        </Border>
    </StackPanel>
</UserControl>
