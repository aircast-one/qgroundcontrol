<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.InstrumentBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="OsdPlace" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeOsdValue}" />
            <Setter Property="Foreground" Value="{ThemeResource OsdTextBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style x:Key="OsdSpeed" TargetType="TextBlock" BasedOn="{StaticResource OsdPlace}">
            <Setter Property="FontSize" Value="{ThemeResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="EditorDialog" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
            <Setter Property="Background" Value="{ThemeResource LayerBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        </Style>
        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusOverlay}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style x:Key="EditorRow" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
        </Style>
        <Style x:Key="EditorRowCurrent" TargetType="Button" BasedOn="{StaticResource EditorRow}">
            <Setter Property="Background" Value="{ThemeResource SubtleSelectedBrush}" />
        </Style>
        <Style x:Key="EditorTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="EditorDetail" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="EditorNote" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="{StaticResource SpaceXs}">
        <StackPanel x:Name="NoticeRow" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" Visibility="Collapsed">
            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource CriticalBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="NoticeText" FontFamily="{ThemeResource AppFontFamily}"
                       FontSize="{ThemeResource FontSizeCaption}" Foreground="{ThemeResource CriticalBrush}" />
        </StackPanel>
        <StackPanel x:Name="Card" Visibility="Collapsed">
            <StackPanel x:Name="SpeedRow" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" />
            <StackPanel x:Name="PlaceRow" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" />
        </StackPanel>
    </StackPanel>
</UserControl>
