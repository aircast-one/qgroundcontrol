<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.VideoThumbnail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AircastQGC.Controls">

    <UserControl.Resources>
        <Style x:Key="VideoHeadline" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="2" />
        </Style>
        <Style x:Key="VideoCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style x:Key="VideoDotLive" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SuccessBrush}" />
        </Style>
        <Style x:Key="VideoDotConnecting" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource CautionBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="Tile"
                Click="OnTileClick"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Padding="0"
                Background="{ThemeResource BgSecondaryBrush}"
                BorderBrush="{ThemeResource TextPrimaryBrush}"
                BorderThickness="2"
                CornerRadius="{ThemeResource RadiusOverlay}"
                AutomationProperties.Name="Swap video and map"
                ToolTipService.ToolTip="Swap video and map">
            <Button.Resources>
                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="TextPrimaryBrush" />
                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="TextPrimaryBrush" />
            </Button.Resources>
            <Grid>
                <local:VideoSurface x:Name="Surface" Channel="0" Visibility="Collapsed" />
                <local:SyntheticView x:Name="Synthetic" />
                <StackPanel x:Name="Placeholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="12,0,12,28"
                            Spacing="{ThemeResource SpaceXs}">
                    <FontIcon Glyph="&#xE714;" FontSize="24" Foreground="{ThemeResource TextTertiaryBrush}" />
                    <TextBlock x:Name="Headline" Text="No video" Style="{StaticResource VideoHeadline}" />
                </StackPanel>
                <Border x:Name="CaptionPill"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="8"
                        Height="20"
                        Padding="8,0"
                        CornerRadius="10"
                        BorderBrush="{ThemeResource CautionBrush}"
                        Background="{ThemeResource ChipBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SpaceXs}">
                        <Ellipse x:Name="Dot" Width="6" Height="6" VerticalAlignment="Center" Style="{StaticResource VideoDotConnecting}" />
                        <TextBlock x:Name="Caption" Text="Video" Style="{StaticResource VideoCaption}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Button>
        <local:PictureTag x:Name="NoCamera"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="16,56,16,16" />
    </Grid>
</UserControl>
