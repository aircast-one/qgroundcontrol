<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.GuidedBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{ThemeResource AppFontFamily}">

    <UserControl.Resources>
        <StaticResource x:Key="ButtonBackground" ResourceKey="ChipBrush" />
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ChipHoverBrush" />
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleSelectedBrush" />
        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ChipBrush" />
        <StaticResource x:Key="ButtonForeground" ResourceKey="TextPrimaryBrush" />
        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextPrimaryBrush" />
        <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextDisabledBrush" />
        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="ControlStrokeBrush" />

        <Style x:Key="RailIcon" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style x:Key="RailIconPrimary" TargetType="FontIcon" BasedOn="{StaticResource RailIcon}">
            <Setter Property="FontSize" Value="24" />
        </Style>

        <Style x:Key="HomeMark" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="3,5,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RailLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource OsdTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MaxLines" Value="1" />
        </Style>

        <Style x:Key="RailPrimaryButton" TargetType="Button" BasedOn="{StaticResource FlyRailButton}">
            <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AccentOnBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel
        x:Name="Root"
        Visibility="Collapsed"
        Spacing="{StaticResource SpaceXl}"
        XYFocusKeyboardNavigation="Enabled">
        <StackPanel Spacing="{StaticResource SpaceSm}">
            <StackPanel x:Name="ChecklistItem" Spacing="{StaticResource SpaceXs}" Visibility="Collapsed">
                <Button
                    x:Name="ChecklistButton"
                    Style="{StaticResource FlyRailButton}"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Pre-flight checklist"
                    ToolTipService.ToolTip="Pre-flight checklist"
                    ToolTipService.Placement="Right">
                    <FontIcon Glyph="&#xE9D5;" Style="{StaticResource RailIcon}" />
                </Button>
            </StackPanel>

            <ItemsControl x:Name="Strip" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource SpaceSm}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel x:Name="MoreItem" Spacing="{StaticResource SpaceXs}">
                <Button
                    x:Name="MoreButton"
                    Style="{StaticResource FlyRailButton}"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="More actions"
                    ToolTipService.ToolTip="More actions"
                    ToolTipService.Placement="Right">
                    <FontIcon Glyph="&#xE712;" Style="{StaticResource RailIcon}" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <RotateTransform Angle="90" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <Button.Flyout>
                        <MenuFlyout x:Name="MoreMenu" Placement="RightEdgeAlignedTop" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="StopItem" Spacing="{StaticResource SpaceXs}" Visibility="Collapsed">
            <Grid Width="48" Height="48" HorizontalAlignment="Center">
                <Button
                    x:Name="StopButton"
                    Style="{StaticResource FlyRailButton}"
                    Background="{ThemeResource ChipBrush}"
                    BorderBrush="{ThemeResource CriticalBrush}"
                    BorderThickness="2"
                    Foreground="{ThemeResource CriticalBrush}"
                    ToolTipService.Placement="Right"
                    Click="StopButton_Click">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackground" ResourceKey="ChipBrush" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ChipHoverBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CriticalBgBrush" />
                        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ChipBrush" />
                        <StaticResource x:Key="ButtonForeground" ResourceKey="CriticalBrush" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CriticalBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CriticalBrush" />
                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="CriticalBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CriticalBrush" />
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CriticalBrush" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE7BA;" Style="{StaticResource RailIcon}" />
                </Button>
                <ProgressRing
                    x:Name="StopHold"
                    Width="48"
                    Height="48"
                    IsIndeterminate="False"
                    IsHitTestVisible="False"
                    Minimum="0"
                    Maximum="1"
                    Value="0"
                    Foreground="{ThemeResource CriticalBrush}"
                    Background="Transparent" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
