<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.GuidedBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{ThemeResource AppFontFamily}">

    <UserControl.Resources>
        <StaticResource x:Key="ButtonBackground" ResourceKey="ControlBrush" />
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlHoverBrush" />
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlBrush" />
        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ControlBrush" />
        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="ControlStrokeBrush" />

        <Style x:Key="GuidedButton" TargetType="Button">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="MaxWidth" Value="104" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="{ThemeResource RadiusControl}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="GuidedIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="GuidedIconDestructive" TargetType="FontIcon" BasedOn="{StaticResource GuidedIcon}">
            <Setter Property="Foreground" Value="{ThemeResource CriticalBrush}" />
        </Style>

        <Style x:Key="GuidedLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="GuidedLabelDestructive" TargetType="TextBlock" BasedOn="{StaticResource GuidedLabel}">
            <Setter Property="Foreground" Value="{ThemeResource CriticalBrush}" />
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="Root"
        Visibility="Collapsed"
        Padding="4"
        Background="{ThemeResource CardBrush}"
        BorderBrush="{ThemeResource CardStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource RadiusOverlay}">
        <ItemsControl x:Name="Strip" IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Border>
</UserControl>
