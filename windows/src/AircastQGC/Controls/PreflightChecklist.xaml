<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.PreflightChecklist"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="400"
    MaxHeight="640"
    Visibility="Collapsed">

    <Border Background="{ThemeResource CardBrush}"
            BorderBrush="{ThemeResource CardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource RadiusOverlay}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="16,16,16,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Pre-flight checklist"
                               FontFamily="{ThemeResource AppFontFamily}"
                               FontSize="{ThemeResource FontSizeBodyLarge}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Name="Subtitle"
                               FontFamily="{ThemeResource AppFontFamily}"
                               FontSize="{ThemeResource FontSizeCaption}"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border x:Name="ReadyPill"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Height="24"
                        Padding="10,0"
                        CornerRadius="12"
                        Background="{ThemeResource SuccessBgBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Ready"
                                   FontFamily="{ThemeResource AppFontFamily}"
                                   FontSize="{ThemeResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource SuccessBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="EmptyText"
                               Visibility="Collapsed"
                               Text="Connect a vehicle to run its preflight checks."
                               TextWrapping="Wrap"
                               FontFamily="{ThemeResource AppFontFamily}"
                               FontSize="{ThemeResource FontSizeBody}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <ItemsControl x:Name="GroupList" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Padding="16,12"
                  BorderBrush="{ThemeResource DividerBrush}"
                  BorderThickness="0,1,0,0">
                <Button x:Name="ResetButton"
                        Content="Reset"
                        MinWidth="96"
                        FontFamily="{ThemeResource AppFontFamily}"
                        FontSize="{ThemeResource FontSizeBody}"
                        Click="OnReset" />
                <Button x:Name="DoneButton"
                        Content="Done"
                        MinWidth="96"
                        HorizontalAlignment="Right"
                        FontFamily="{ThemeResource AppFontFamily}"
                        FontSize="{ThemeResource FontSizeBody}"
                        Click="OnDone" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
