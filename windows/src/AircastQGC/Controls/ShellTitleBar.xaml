<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.ShellTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AircastQGC.Controls"
    Height="{StaticResource SizeTitlebar}">

    <UserControl.Resources>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="SubtitleText" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        </Style>

        <Style x:Key="PillIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{ThemeResource ChipBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="{ThemeResource ChipHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleSelectedBrush}" />
                                            <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Bar" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="CaptionColumn" Width="138" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="Lead" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="8,0,0,0">
            <Button x:Name="MenuButton" Style="{StaticResource FlyRoundButton}" Content="&#xE700;" Margin="0,0,4,0"
                    Foreground="{ThemeResource TextPrimaryBrush}" Background="Transparent"
                    Width="32" Height="32" CornerRadius="16"
                    Click="OnMenu" AutomationProperties.Name="Menu" ToolTipService.ToolTip="Menu">
                <Button.Flyout>
                    <MenuFlyout x:Name="PageMenu" Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem x:Name="BackItem" Text="Back" Click="OnBack">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72B;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator x:Name="BackSeparator" />
                        <RadioMenuFlyoutItem Text="Fly" Tag="Fly" GroupName="Pages" Click="OnPage">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE709;" />
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem Text="Plan" Tag="Plan" GroupName="Pages" Click="OnPage">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE707;" />
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem Text="Analyze" Tag="Analyze" GroupName="Pages" Click="OnPage">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE9D9;" />
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem Text="Vehicle Setup" Tag="Vehicle Setup" GroupName="Pages" Click="OnPage">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE90F;" />
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem Text="Settings" Tag="Settings" GroupName="Pages" Click="OnPage">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Border x:Name="Logo" Width="20" Height="20" VerticalAlignment="Center"
                    CornerRadius="{StaticResource RadiusControl}" Background="{ThemeResource AccentBrush}">
                <FontIcon Glyph="&#xE709;" FontSize="12" Foreground="{ThemeResource AccentOnBrush}" />
            </Border>

            <StackPanel x:Name="Readings" Orientation="Horizontal" Spacing="12">
                <local:VehiclePickerButton x:Name="VehicleSwitch" />

                <local:OperatorControlButton />

                <local:VtolStateCell />

                <Button x:Name="ModePill" Style="{StaticResource TitleButton}" Click="OnModeClick"
                        AutomationProperties.Name="Flight mode" ToolTipService.ToolTip="Flight mode">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE709;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock x:Name="ModeText" Style="{StaticResource PillText}" FontSize="{ThemeResource FontSizeBodyLarge}" FontWeight="SemiBold" />
                        <FontIcon x:Name="ModeChevron" Glyph="&#xE70D;" FontSize="12"
                                  Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ProgressRing x:Name="ModePending" Width="12" Height="12" MinWidth="12" MinHeight="12"
                                      IsActive="False" Visibility="Collapsed" Foreground="{ThemeResource AccentBrush}" />
                    </StackPanel>
                </Button>

                <Button x:Name="ArmedPill" Style="{StaticResource PillButton}" Height="32" CornerRadius="16" Padding="16,0" Click="OnStatusClick"
                        AutomationProperties.Name="Vehicle status" ToolTipService.ToolTip="Vehicle status">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="ArmedIcon" Glyph="&#xE72E;" Style="{StaticResource PillIcon}" />
                        <TextBlock x:Name="ArmedText" Style="{StaticResource PillText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <Grid x:Name="DragArea" Grid.Column="1" Background="Transparent" Padding="16,0,8,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="AppTitle" Text="Aircast QGC" Style="{StaticResource TitleText}" />
            <TextBlock x:Name="Subtitle" Grid.Column="1" Style="{StaticResource SubtitleText}" />
        </Grid>

        <StackPanel x:Name="RightGroup" Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,16,0">
            <Border x:Name="Readout" Height="32" Padding="4,0" CornerRadius="16" VerticalAlignment="Center"
                    Background="{ThemeResource ChipBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <StackPanel x:Name="Fixed" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="LinkPill" Style="{StaticResource PillButton}" Click="OnLinkClick"
                                AutomationProperties.Name="Connections" ToolTipService.ToolTip="Connections">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="LinkIcon" Glyph="&#xE71B;" Style="{StaticResource PillIcon}" />
                                <TextBlock x:Name="LinkText" Style="{StaticResource PillText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <local:StatusStrip x:Name="Strip" />
                </StackPanel>
            </Border>

            <Button x:Name="MoreButton" Style="{StaticResource FlyRoundButton}" Content="&#xE712;" Click="OnMore"
                    Foreground="{ThemeResource TextPrimaryBrush}" Background="Transparent"
                    Width="32" Height="32" CornerRadius="16"
                    Visibility="Collapsed" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings" />
        </StackPanel>
    </Grid>
</UserControl>
