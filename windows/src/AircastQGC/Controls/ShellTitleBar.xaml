<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.ShellTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AircastQGC.Controls"
    Height="{StaticResource SizeTitlebar}">

    <UserControl.Resources>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="SubtitleText" TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{ThemeResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PillIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{ThemeResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="{ThemeResource ControlHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleSelectedBrush}" />
                                            <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource BgSecondaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="CaptionColumn" Width="138" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="DragArea" Background="Transparent" Padding="16,0,8,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="20" Height="20" VerticalAlignment="Center"
                    CornerRadius="{StaticResource RadiusControl}" Background="{ThemeResource AccentBrush}">
                <FontIcon Glyph="&#xE709;" FontSize="12" Foreground="{ThemeResource AccentOnBrush}" />
            </Border>
            <TextBlock Grid.Column="1" Text="Aircast QGC" Style="{StaticResource TitleText}" />
            <TextBlock x:Name="Subtitle" Grid.Column="2" Style="{StaticResource SubtitleText}" />
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
            <Button x:Name="LinkPill" Style="{StaticResource PillButton}" Click="OnLinkClick"
                    AutomationProperties.Name="Connections" ToolTipService.ToolTip="Connections">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="LinkIcon" Glyph="&#xE71B;" Style="{StaticResource PillIcon}" />
                    <TextBlock x:Name="LinkText" Style="{StaticResource PillText}" />
                </StackPanel>
            </Button>

            <StackPanel x:Name="Readings" Orientation="Horizontal" Spacing="4">
                <local:VehiclePickerButton x:Name="VehicleSwitch" />

                <Button x:Name="ModePill" Style="{StaticResource PillButton}" Click="OnModeClick"
                        AutomationProperties.Name="Flight mode" ToolTipService.ToolTip="Flight mode">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE709;" Style="{StaticResource PillIcon}" Foreground="{ThemeResource AccentBrush}" />
                        <TextBlock x:Name="ModeText" Style="{StaticResource PillText}" />
                        <FontIcon x:Name="ModeChevron" Glyph="&#xE70D;" FontSize="10"
                                  Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ProgressRing x:Name="ModePending" Width="12" Height="12" MinWidth="12" MinHeight="12"
                                      IsActive="False" Visibility="Collapsed" Foreground="{ThemeResource AccentBrush}" />
                    </StackPanel>
                </Button>

                <Button x:Name="ArmedPill" Style="{StaticResource PillButton}" Click="OnStatusClick"
                        AutomationProperties.Name="Vehicle status" ToolTipService.ToolTip="Vehicle status">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="ArmedIcon" Glyph="&#xE72E;" Style="{StaticResource PillIcon}" />
                        <TextBlock x:Name="ArmedText" Style="{StaticResource PillText}" />
                    </StackPanel>
                </Button>

                <local:GimbalIndicator />
            </StackPanel>

            <local:StatusStrip x:Name="Strip" />
        </StackPanel>
    </Grid>
</UserControl>
