<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.GuidedConfirm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{ThemeResource AppFontFamily}"
    FontSize="{ThemeResource FontSizeBody}">

    <UserControl.Resources>
        <StaticResource x:Key="ButtonBackground" ResourceKey="ControlBrush" />
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlHoverBrush" />
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlBrush" />
        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonForeground" ResourceKey="TextPrimaryBrush" />
        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextSecondaryBrush" />
        <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush" />
        <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentHoverBrush" />
        <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentBrush" />
        <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentBrush" />
        <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentHoverBrush" />
        <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="AccentHoverBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="AccentOnBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="AccentOnBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="AccentOnBrush" />

        <Style x:Key="ConfirmTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeSubtitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ConfirmTitleDestructive" TargetType="TextBlock" BasedOn="{StaticResource ConfirmTitle}">
            <Setter Property="Foreground" Value="{ThemeResource CriticalBrush}" />
        </Style>

        <Style x:Key="ConfirmCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="KnobStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="{ThemeResource RadiusPill}" />
            <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
        </Style>

        <Style x:Key="KnobDestructiveStyle" TargetType="Border" BasedOn="{StaticResource KnobStyle}">
            <Setter Property="Background" Value="{ThemeResource CriticalBrush}" />
        </Style>

        <Style x:Key="HoldButton" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AccentOnBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource RadiusControl}" />
            <Setter Property="MinHeight" Value="{StaticResource SizeControl}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeBody}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Opacity" Value="0.9" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Opacity" Value="0.8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HoldButtonDestructive" TargetType="Button" BasedOn="{StaticResource HoldButton}">
            <Setter Property="Background" Value="{ThemeResource StopBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource StopBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource StopOnBrush}" />
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="Root"
        Visibility="Collapsed"
        Width="320"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="16"
        Background="{ThemeResource CardBrush}"
        BorderBrush="{ThemeResource CardStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource RadiusOverlay}">
        <StackPanel Spacing="12">
            <TextBlock x:Name="TitleText" Style="{StaticResource ConfirmTitle}" />

            <TextBlock
                x:Name="PromptText"
                FontSize="{ThemeResource FontSizeBody}"
                Foreground="{ThemeResource TextSecondaryBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="WarningText"
                Visibility="Collapsed"
                FontSize="{ThemeResource FontSizeBody}"
                Foreground="{ThemeResource CautionBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel x:Name="ValuePanel" Spacing="4" Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <Button
                            x:Name="ValueButton"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            AutomationProperties.Name="Type a value"
                            Click="ValueButton_Click">
                            <TextBlock
                                x:Name="ValueText"
                                FontSize="{ThemeResource FontSizeTitle}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}" />
                        </Button>
                        <TextBox
                            x:Name="ValueEntry"
                            Visibility="Collapsed"
                            Width="140"
                            HorizontalAlignment="Left"
                            InputScope="Number"
                            AutomationProperties.Name="Value"
                            TextChanged="ValueEntry_TextChanged"
                            KeyDown="ValueEntry_KeyDown"
                            LostFocus="ValueEntry_LostFocus" />
                        <TextBlock x:Name="ValueLabel" Style="{StaticResource ConfirmCaption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Content="&#x2212;"
                            Width="40"
                            Height="40"
                            Padding="0"
                            FontSize="{ThemeResource FontSizeSubtitle}"
                            CornerRadius="{ThemeResource RadiusPill}"
                            BorderThickness="1"
                            AutomationProperties.Name="Decrease"
                            Click="StepDown_Click" />
                        <Button
                            Content="+"
                            Width="40"
                            Height="40"
                            Padding="0"
                            FontSize="{ThemeResource FontSizeSubtitle}"
                            CornerRadius="{ThemeResource RadiusPill}"
                            BorderThickness="1"
                            AutomationProperties.Name="Increase"
                            Click="StepUp_Click" />
                    </StackPanel>
                </Grid>
                <Slider
                    x:Name="ValueSlider"
                    StepFrequency="0.1"
                    IsThumbToolTipEnabled="False"
                    ValueChanged="ValueSlider_ValueChanged" />
                <Grid>
                    <TextBlock x:Name="MinimumText" Style="{StaticResource ConfirmCaption}" />
                    <TextBlock x:Name="MaximumText" Style="{StaticResource ConfirmCaption}" HorizontalAlignment="Right" />
                </Grid>
                <StackPanel x:Name="PicksRow" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" Visibility="Collapsed" />
            </StackPanel>

            <ContentPresenter x:Name="FieldsHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" />

            <TextBlock x:Name="DetailText" Visibility="Collapsed" Style="{StaticResource ConfirmCaption}"
                       HorizontalAlignment="Center" IsTextSelectionEnabled="True" />

            <CheckBox
                x:Name="OptionCheck"
                Visibility="Collapsed"
                Foreground="{ThemeResource TextPrimaryBrush}" />

            <TextBlock
                x:Name="ErrorText"
                Visibility="Collapsed"
                FontSize="{ThemeResource FontSizeBody}"
                Foreground="{ThemeResource CriticalBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Button
                x:Name="AlternativeButton"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                CornerRadius="{ThemeResource RadiusControl}"
                BorderThickness="1"
                Click="AlternativeButton_Click" />

            <Border
                CornerRadius="21"
                Background="{ThemeResource ControlBrush}"
                BorderBrush="{ThemeResource ControlStrokeBrush}"
                BorderThickness="1">
                <Grid x:Name="SlideTrack" Height="40">
                    <TextBlock
                        x:Name="SlideText"
                        Margin="44,0,12,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{ThemeResource FontSizeBody}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        x:Name="Knob"
                        Style="{StaticResource KnobStyle}"
                        PointerPressed="Knob_PointerPressed"
                        PointerMoved="Knob_PointerMoved"
                        PointerReleased="Knob_PointerReleased"
                        PointerCanceled="Knob_PointerEnded"
                        PointerCaptureLost="Knob_PointerEnded">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="KnobShift" />
                        </Border.RenderTransform>
                        <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource AccentOnBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnSpacing="{StaticResource SpaceSm}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ConfirmButton"
                    Style="{StaticResource HoldButton}"
                    AutomationProperties.HelpText="Hold to confirm, or press Enter."
                    PreviewKeyDown="ConfirmButton_PreviewKeyDown"
                    PreviewKeyUp="ConfirmButton_PreviewKeyUp"
                    Click="ConfirmButton_Click">
                    <Grid>
                        <Border
                            x:Name="HoldFill"
                            Opacity="0.3"
                            IsHitTestVisible="False"
                            RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="HoldScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock
                            x:Name="ConfirmText"
                            Margin="12,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>
                <Button
                    x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    MinWidth="80"
                    CornerRadius="{ThemeResource RadiusControl}"
                    BorderThickness="1"
                    Click="CancelButton_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <TextBlock
                Text="Hold to confirm, or press Enter"
                Style="{StaticResource ConfirmCaption}"
                Margin="0,-4,0,0"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
