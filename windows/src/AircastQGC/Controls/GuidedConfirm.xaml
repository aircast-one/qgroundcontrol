<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AircastQGC.Controls.GuidedConfirm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{ThemeResource AppFontFamily}"
    FontSize="{ThemeResource FontSizeBody}">

    <UserControl.Resources>
        <StaticResource x:Key="ButtonBackground" ResourceKey="ControlBrush" />
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlHoverBrush" />
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlBrush" />
        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlStrokeBrush" />
        <StaticResource x:Key="ButtonForeground" ResourceKey="TextPrimaryBrush" />
        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextPrimaryBrush" />
        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextSecondaryBrush" />
        <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush" />
        <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentHoverBrush" />
        <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentBrush" />
        <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentBrush" />
        <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentHoverBrush" />
        <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="AccentHoverBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="AccentOnBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="AccentOnBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="AccentOnBrush" />

        <Style x:Key="ConfirmTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeSubtitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ConfirmTitleDestructive" TargetType="TextBlock" BasedOn="{StaticResource ConfirmTitle}">
            <Setter Property="Foreground" Value="{ThemeResource CriticalBrush}" />
        </Style>

        <Style x:Key="ConfirmCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="KnobStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="{ThemeResource RadiusPill}" />
            <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
        </Style>

        <Style x:Key="KnobDestructiveStyle" TargetType="Border" BasedOn="{StaticResource KnobStyle}">
            <Setter Property="Background" Value="{ThemeResource CriticalBrush}" />
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="Root"
        Visibility="Collapsed"
        Width="320"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="16"
        Background="{ThemeResource CardBrush}"
        BorderBrush="{ThemeResource CardStrokeBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource RadiusOverlay}">
        <StackPanel Spacing="12">
            <TextBlock x:Name="TitleText" Style="{StaticResource ConfirmTitle}" />

            <TextBlock
                x:Name="PromptText"
                FontSize="{ThemeResource FontSizeBody}"
                Foreground="{ThemeResource TextSecondaryBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="WarningText"
                Visibility="Collapsed"
                FontSize="{ThemeResource FontSizeBody}"
                Foreground="{ThemeResource CautionBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel x:Name="ValuePanel" Spacing="4" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="ValueLabel" Style="{StaticResource ConfirmCaption}" />
                    <TextBlock
                        x:Name="ValueText"
                        HorizontalAlignment="Right"
                        FontSize="{ThemeResource FontSizeBodyLarge}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}" />
                </Grid>
                <Slider
                    x:Name="ValueSlider"
                    StepFrequency="0.1"
                    IsThumbToolTipEnabled="False"
                    ValueChanged="ValueSlider_ValueChanged" />
                <Grid>
                    <TextBlock x:Name="MinimumText" Style="{StaticResource ConfirmCaption}" />
                    <TextBlock x:Name="MaximumText" Style="{StaticResource ConfirmCaption}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <ContentPresenter x:Name="FieldsHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" />

            <TextBlock x:Name="DetailText" Visibility="Collapsed" Style="{StaticResource ConfirmCaption}"
                       HorizontalAlignment="Center" IsTextSelectionEnabled="True" />

            <CheckBox
                x:Name="OptionCheck"
                Visibility="Collapsed"
                Foreground="{ThemeResource TextPrimaryBrush}" />

            <TextBlock
                x:Name="ErrorText"
                Visibility="Collapsed"
                FontSize="{ThemeResource FontSizeBody}"
                Foreground="{ThemeResource CriticalBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Button
                x:Name="AlternativeButton"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                CornerRadius="{ThemeResource RadiusControl}"
                BorderThickness="1"
                Click="AlternativeButton_Click" />

            <Border
                CornerRadius="21"
                Background="{ThemeResource ControlBrush}"
                BorderBrush="{ThemeResource ControlStrokeBrush}"
                BorderThickness="1">
                <Grid x:Name="SlideTrack" Height="40">
                    <TextBlock
                        x:Name="SlideText"
                        Margin="44,0,12,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{ThemeResource FontSizeBody}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        x:Name="Knob"
                        Style="{StaticResource KnobStyle}"
                        PointerPressed="Knob_PointerPressed"
                        PointerMoved="Knob_PointerMoved"
                        PointerReleased="Knob_PointerReleased"
                        PointerCanceled="Knob_PointerEnded"
                        PointerCaptureLost="Knob_PointerEnded">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="KnobShift" />
                        </Border.RenderTransform>
                        <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource AccentOnBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Button
                x:Name="CancelButton"
                Content="Cancel"
                MinWidth="80"
                HorizontalAlignment="Center"
                CornerRadius="{ThemeResource RadiusControl}"
                BorderThickness="1"
                Click="CancelButton_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
