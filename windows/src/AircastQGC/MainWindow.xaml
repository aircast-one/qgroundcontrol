<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AircastQGC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AircastQGC.Controls"
    Title="Aircast QGC">

    <Grid Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ShellTitleBar x:Name="Shell" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:NavPane x:Name="Nav" Grid.RowSpan="2" />

            <Grid x:Name="FlyContent" Grid.Column="1">
                <controls:MapView x:Name="Map" />

                <controls:MapPayloadLayer x:Name="MapPayload" />

                <controls:BatteryReturnBar />

                <controls:VideoThumbnail x:Name="VideoTile"
                                         Width="260" Height="150" Margin="16"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" />

                <controls:VideoPayloadLayer x:Name="VideoLayer"
                                            Width="260" Height="150" Margin="16"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" />

                <controls:PipTile Width="160" Height="90" Margin="16,16,292,16"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" />

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16"
                            Spacing="{StaticResource SpaceSm}">
                    <controls:GuidedBar x:Name="GuidedStrip" HorizontalAlignment="Center" />
                    <controls:MissionProgressCard x:Name="MissionProgress" HorizontalAlignment="Center" />
                    <controls:OrbitReadout HorizontalAlignment="Center" />
                    <InfoBar x:Name="Notice" Severity="Error" IsClosable="True" IsOpen="False"
                             HorizontalAlignment="Center" MaxWidth="480" />
                    <controls:TrafficBanner HorizontalAlignment="Center" />
                    <controls:VehicleMessageBanner x:Name="MessageBanner" HorizontalAlignment="Center" />
                    <controls:TerrainDataWarning x:Name="TerrainWarning" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16"
                            Spacing="{StaticResource SpaceXs}">
                    <controls:MapControls x:Name="MapButtons" />
                    <Button x:Name="CameraButton" Style="{StaticResource MapControl}" Content="&#xE722;"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Camera" AutomationProperties.Name="Camera" />
                    <Button x:Name="ChecklistButton" Style="{StaticResource MapControl}" Content="&#xE9D5;"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Pre-flight checklist" AutomationProperties.Name="Pre-flight checklist" />
                </StackPanel>

                <controls:StreamShutter x:Name="Shutter"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,16,68,16" />

                <controls:InstrumentBar x:Name="ReadingsBar"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,16,280,16" />

                <controls:TelemetryPanel x:Name="TelemetryCard"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" />

                <controls:VideoStatsPill x:Name="VideoStats"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,16,16,124" />

                <controls:RcControlsLayer HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16" />

                <controls:CameraOverlay x:Name="CameraPanel"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,182,68,16"
                                        Visibility="Collapsed" />

                <controls:GripperPanel x:Name="Gripper"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,182,68,16" />

                <StackPanel x:Name="FleetColumn" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,96,16,16"
                            Spacing="{StaticResource SpaceSm}">
                    <controls:FollowMeReadout x:Name="FollowMe" />
                    <controls:FleetCard x:Name="FleetPanel" />
                </StackPanel>

                <controls:PreflightChecklist x:Name="Checklist"
                                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" />

                <controls:NoVehicleState x:Name="NoVehicle" />

                <controls:ConnectingCard />

                <controls:GuidedConfirm x:Name="GuidedCard" />

                <controls:MapContextMenu x:Name="MapMenu" />
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Column="1" Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Background="{ThemeResource BgBaseBrush}" />

            <Grid x:Name="PagePlaceholder" Grid.Column="1" Visibility="Collapsed" Background="{ThemeResource BgBaseBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource SpaceSm}">
                    <TextBlock x:Name="PageTitle" HorizontalAlignment="Center"
                               FontFamily="{ThemeResource AppFontFamily}" FontSize="{ThemeResource FontSizeTitle}"
                               FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="This page is not in the Windows head yet." HorizontalAlignment="Center"
                               FontFamily="{ThemeResource AppFontFamily}" FontSize="{ThemeResource FontSizeBody}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <controls:LogReplayBar Grid.Row="1" Grid.Column="1" />

            <controls:NoticeLayer x:Name="Notices" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
