<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AircastQGC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AircastQGC.Controls"
    Title="Aircast QGC">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="FlyContent" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <controls:MapView x:Name="Map" />

            <controls:MapPayloadLayer x:Name="MapPayload" />

            <controls:ObstacleMapLayer x:Name="ObstacleOnMap" />

            <controls:Viewer3DView x:Name="Viewer" />

            <Button x:Name="PipFrame" Style="{StaticResource PipFrame}" Visibility="Collapsed"
                    AutomationProperties.Name="Show the map" ToolTipService.ToolTip="Show the map" />

            <Border x:Name="TopScrim" Height="{StaticResource SizeFlyScrim}" VerticalAlignment="Top"
                    IsHitTestVisible="False" Background="{ThemeResource FlyScrimBrush}" />

            <controls:VideoThumbnail x:Name="VideoTile" />

            <controls:VideoMarks x:Name="Marks" />

            <controls:VideoPayloadLayer x:Name="VideoLayer" />

            <controls:BatteryReturnBar x:Name="ReturnBar" />
        </Grid>

        <Grid x:Name="FlyChrome" Grid.Row="1" Grid.ColumnSpan="2">
            <StackPanel x:Name="TopArea" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,4,16,16"
                        Spacing="{StaticResource SpaceSm}">
                <controls:HeadingTape x:Name="Tape" HorizontalAlignment="Center" />
                <controls:TrafficBanner HorizontalAlignment="Center" />
                <StackPanel x:Name="Overlays" Spacing="{StaticResource SpaceSm}">
                    <controls:ControlRequestPrompt HorizontalAlignment="Center" />
                    <controls:LayoutSlot Key="missionProgress" Label="Mission progress" HorizontalAlignment="Center">
                        <controls:MissionProgressCard x:Name="MissionProgress" HorizontalAlignment="Center" />
                    </controls:LayoutSlot>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource SpaceSm}">
                        <controls:ObstacleArc VerticalAlignment="Center" />
                        <controls:LayoutSlot Key="obstacleReadout" Label="Obstacle distance" VerticalAlignment="Center">
                            <controls:ObstacleReadout VerticalAlignment="Center" />
                        </controls:LayoutSlot>
                    </StackPanel>
                    <controls:OrbitReadout HorizontalAlignment="Center" />
                    <InfoBar x:Name="Notice" Severity="Error" IsClosable="True" IsOpen="False"
                             HorizontalAlignment="Center" MaxWidth="480" />
                    <controls:LayoutSlot Key="messageBanner" Label="Vehicle messages" Hideable="False" HorizontalAlignment="Center">
                        <controls:VehicleMessageBanner x:Name="MessageBanner" HorizontalAlignment="Center" />
                    </controls:LayoutSlot>
                    <controls:LayoutSlot Key="terrainData" Label="Terrain data warning" HorizontalAlignment="Center">
                        <controls:TerrainDataWarning x:Name="TerrainWarning" HorizontalAlignment="Center" />
                    </controls:LayoutSlot>
                    <controls:DeviceStatusChip HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="LeftRail" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16"
                        Spacing="{StaticResource SpaceSm}">
                <controls:GuidedBar x:Name="GuidedStrip" />
            </StackPanel>

            <Grid x:Name="BottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,16,280,16"
                  ColumnSpacing="{StaticResource SpaceLg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:PipTile Width="160" Height="90" Margin="0,0,0,8" HorizontalAlignment="Left" />
                <Border x:Name="PipSlot" Grid.Row="1" Width="320" Height="180" IsHitTestVisible="False" />
                <Grid x:Name="OsdSlot" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom">
                    <controls:InstrumentBar x:Name="ReadingsBar" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>

            <ScrollViewer x:Name="RightColumn" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <controls:CameraSwitch VerticalAlignment="Top" />
                    <StackPanel MinWidth="56" Spacing="{StaticResource SpaceMd}">
                        <Border x:Name="AimSlot" HorizontalAlignment="Center" />
                        <controls:StreamShutter x:Name="Shutter" HorizontalAlignment="Center" />
                        <Button x:Name="CameraButton" Style="{StaticResource FlyRoundButton}" Content="&#xE722;"
                                HorizontalAlignment="Center" Visibility="Collapsed"
                                ToolTipService.ToolTip="Camera" AutomationProperties.Name="Camera" />
                        <Button x:Name="FullScreenButton" Style="{StaticResource FlyRoundButton}" Content="&#xE740;"
                                HorizontalAlignment="Center" Visibility="Collapsed"
                                ToolTipService.ToolTip="Full-screen video (F11)" AutomationProperties.Name="Full-screen video" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="MapCorner" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
                <controls:MapControls x:Name="MapButtons" />
            </Grid>

            <Grid x:Name="CenterMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                <controls:NoVideoPill x:Name="NoVideoMessage" />
            </Grid>

            <controls:TelemetryPanel x:Name="TelemetryCard" Visibility="Collapsed"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" />

            <controls:VideoStatsPill x:Name="VideoStats"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,16,16,124" />

            <Grid x:Name="LeftColumn" HorizontalAlignment="Left" Margin="16,96,16,124" RowSpacing="{StaticResource SpaceSm}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="FleetScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FleetColumn" Spacing="{StaticResource SpaceSm}">
                        <controls:FollowMeReadout x:Name="FollowMe" />
                        <controls:LayoutSlot Key="fleet" Label="Fleet">
                            <controls:FleetCard x:Name="FleetPanel" />
                        </controls:LayoutSlot>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" VerticalAlignment="Center"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <controls:RcControlsLayer x:Name="RcLayer" />
                </ScrollViewer>
            </Grid>

            <controls:VirtualJoystick Margin="16,16,280,160" />

            <controls:CameraOverlay x:Name="CameraPanel"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                                    Visibility="Collapsed" />

            <controls:GripperPanel x:Name="Gripper"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" />

            <controls:PreflightChecklist x:Name="Checklist"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" />

            <controls:NoVehicleState x:Name="NoVehicle" />

            <controls:ConnectingCard />

            <controls:LayoutEditBar x:Name="LayoutBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,16,16,124" />

            <controls:GuidedConfirm x:Name="GuidedCard" HorizontalAlignment="Left" Margin="16" />

            <controls:MapContextMenu x:Name="MapMenu" />
        </Grid>

        <controls:ShellTitleBar x:Name="Shell" Grid.ColumnSpan="2" />

        <controls:NavPane x:Name="Nav" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />

        <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <Grid x:Name="PagePlaceholder" Grid.Row="1" Grid.Column="1" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource SpaceSm}">
                <TextBlock x:Name="PageTitle" HorizontalAlignment="Center"
                           FontFamily="{ThemeResource AppFontFamily}" FontSize="{ThemeResource FontSizeTitle}"
                           FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="This page is not in the Windows head yet." HorizontalAlignment="Center"
                           FontFamily="{ThemeResource AppFontFamily}" FontSize="{ThemeResource FontSizeBody}"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <controls:LogReplayBar Grid.Row="2" Grid.Column="1" />

        <controls:NoticeLayer x:Name="Notices" Grid.Row="1" Grid.Column="1" />

        <controls:DeepLinkSetupPrompt Grid.RowSpan="3" Grid.ColumnSpan="2" />
    </Grid>
</Window>
