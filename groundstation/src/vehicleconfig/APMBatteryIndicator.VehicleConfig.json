{
    "fileType": "VehicleConfig",
    "version": 1,
    "sections": [
        {
            "title": "Low Voltage Failsafe",
            "showWhen": "controller.parameterExists(-1, \"BATT_MONITOR\") && controller.getParameterFact(-1, \"BATT_MONITOR\").rawValue !== 0",
            "controls": [
                {
                    "param": "BATT_FS_LOW_ACT",
                    "label": "Vehicle Action",
                    "control": "combobox",
                    "optional": true
                },
                {
                    "param": "BATT_LOW_VOLT",
                    "label": "Voltage Trigger",
                    "control": "slider",
                    "optional": true,
                    "sliderMin": 0,
                    "sliderMax": 100,
                    "majorTickStepSize": 5,
                    "labelWhenZero": "Voltage Trigger - disabled"
                },
                {
                    "param": "BATT_LOW_MAH",
                    "label": "mAh Trigger",
                    "control": "slider",
                    "optional": true,
                    "sliderMin": 0,
                    "sliderMax": 30000,
                    "majorTickStepSize": 1000,
                    "labelWhenZero": "mAh Trigger - disabled"
                }
            ]
        },
        {
            "title": "Critical Voltage Failsafe",
            "showWhen": "controller.parameterExists(-1, \"BATT_MONITOR\") && controller.getParameterFact(-1, \"BATT_MONITOR\").rawValue !== 0",
            "controls": [
                {
                    "param": "BATT_FS_CRT_ACT",
                    "label": "Vehicle Action",
                    "control": "combobox",
                    "optional": true
                },
                {
                    "param": "BATT_CRT_VOLT",
                    "label": "Voltage Trigger",
                    "control": "slider",
                    "optional": true,
                    "sliderMin": 0,
                    "sliderMax": 100,
                    "majorTickStepSize": 5,
                    "labelWhenZero": "Voltage Trigger - disabled"
                },
                {
                    "param": "BATT_CRT_MAH",
                    "label": "mAh Trigger",
                    "control": "slider",
                    "optional": true,
                    "sliderMin": 0,
                    "sliderMax": 30000,
                    "majorTickStepSize": 1000,
                    "labelWhenZero": "mAh Trigger - disabled"
                }
            ]
        }
    ]
}
