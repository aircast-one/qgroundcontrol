{
    "fileType": "VehicleConfig",
    "version": 1,
    "params": {
        "_armingCheck": { "name": "ARMING_CHECK", "required": false },
        "_armingSkipCheck": { "name": "ARMING_SKIPCHK", "required": false }
    },
    "sections": [
        {
            "title": "Arming Checks",
            "controls": [
                { "control": "label", "label": "Skipping arming checks can lead to loss of vehicle control.", "warning": true, "showWhen": "_armingCheck ? _armingCheck.value !== 1 : (_armingSkipCheck && _armingSkipCheck.value !== 0)" },
                { "param": "ARMING_CHECK", "label": "Arming checks", "heading": "Arming checks", "control": "bitmask", "optional": true, "firstEntryIsAll": true, "showWhen": "_armingCheck" },
                { "param": "ARMING_SKIPCHK", "label": "Skip arming checks", "heading": "Arming checks to skip", "control": "bitmask", "optional": true, "showWhen": "!_armingCheck && _armingSkipCheck" }
            ]
        }
    ]
}
