{
    "fileType": "VehicleConfig",
    "version": 1,
    "constants": {
        "_allSimpleBits": 63
    },
    "state": {
        "_customSimple": false
    },
    "params": {
        "_simple": "SIMPLE",
        "_superSimple": "SUPER_SIMPLE"
    },
    "sections": [
        {
            "title": "Simple Mode",
            "showWhen": "controller.parameterExists(-1, \"SIMPLE\") && controller.parameterExists(-1, \"SUPER_SIMPLE\")",
            "controls": [
                {
                    "param": "SIMPLE",
                    "label": "Simple Mode",
                    "control": "radiogroup",
                    "options": [
                        {
                            "label": "Off",
                            "checked": "!_customSimple && _simple.rawValue === 0 && _superSimple.rawValue === 0",
                            "onSelected": "{ _simple.rawValue = 0; _superSimple.rawValue = 0; _customSimple = false }"
                        },
                        {
                            "label": "Simple",
                            "checked": "!_customSimple && _simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0",
                            "onSelected": "{ _simple.rawValue = _allSimpleBits; _superSimple.rawValue = 0; _customSimple = false }"
                        },
                        {
                            "label": "Super-Simple",
                            "checked": "!_customSimple && _simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits",
                            "onSelected": "{ _simple.rawValue = 0; _superSimple.rawValue = _allSimpleBits; _customSimple = false }"
                        },
                        {
                            "label": "Custom",
                            "checked": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))",
                            "onSelected": "{ _simple.rawValue = 0; _superSimple.rawValue = 0; _customSimple = true }"
                        }
                    ]
                },
                {
                    "param": "SIMPLE",
                    "label": "Flight Mode 1 Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 1,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                },
                {
                    "param": "SIMPLE",
                    "label": "Flight Mode 2 Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 2,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                },
                {
                    "param": "SIMPLE",
                    "label": "Flight Mode 3 Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 4,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                },
                {
                    "param": "SIMPLE",
                    "label": "Flight Mode 4 Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 8,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                },
                {
                    "param": "SIMPLE",
                    "label": "Flight Mode 5 Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 16,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                },
                {
                    "param": "SIMPLE",
                    "label": "Flight Mode 6 Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 32,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                },
                {
                    "param": "SUPER_SIMPLE",
                    "label": "Flight Mode 1 Super-Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 1,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                },
                {
                    "param": "SUPER_SIMPLE",
                    "label": "Flight Mode 2 Super-Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 2,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                },
                {
                    "param": "SUPER_SIMPLE",
                    "label": "Flight Mode 3 Super-Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 4,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                },
                {
                    "param": "SUPER_SIMPLE",
                    "label": "Flight Mode 4 Super-Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 8,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                },
                {
                    "param": "SUPER_SIMPLE",
                    "label": "Flight Mode 5 Super-Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 16,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                },
                {
                    "param": "SUPER_SIMPLE",
                    "label": "Flight Mode 6 Super-Simple",
                    "control": "bitmaskCheckbox",
                    "bitMask": 32,
                    "showWhen": "_customSimple || (!(_simple.rawValue === 0 && _superSimple.rawValue === 0) && !(_simple.rawValue === _allSimpleBits && _superSimple.rawValue === 0) && !(_simple.rawValue === 0 && _superSimple.rawValue === _allSimpleBits))"
                }
            ]
        }
    ]
}
